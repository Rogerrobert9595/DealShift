# Optional: Google OAuth credentials for "Continue with Google" / "Sign up with Google".
# In Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth 2.0 Client ID (Web application):
#   Authorized redirect URI: https://<your-worker-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: Configure Resend for transactional password-reset emails on Cloudflare Workers.
# When omitted, password reset links are returned directly in the UI for local/self-hosted use.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="DealShift <noreply@example.com>"
