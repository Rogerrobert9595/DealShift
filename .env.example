# Optional: Configure Resend for transactional password-reset emails on Cloudflare Workers.
# When omitted, password reset links are returned directly in the UI for local/self-hosted use.
# Set in Cloudflare Workers via: npx wrangler secret put RESEND_API_KEY
RESEND_API_KEY=""
RESEND_FROM_EMAIL="DealShift <noreply@example.com>"
